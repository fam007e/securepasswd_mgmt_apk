<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- windowBackground matches the dark launch color so the cold-start
         window never flashes white; Compose paints the actual UI. -->
    <style name="Theme.SecurePasswd_MGMT_APK" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background_dark</item>
    </style>

    <!-- Applied in MainActivity.attachBaseContext for users whose stored
         theme is light; corrects the post-splash window background. -->
    <style name="LaunchBackground" />
    <style name="LaunchBackground.Light">
        <item name="android:windowBackground">@color/launch_background_light</item>
    </style>
</resources>
